# .codedna — auto-generated by codedna init
project: synrax
packages:
  synrax/extract/:
    purpose: "CodeDNA parser — .codedna YAML + Python docstrings → RDF/Turtle triples"
    depends_on: [synrax/schema/]
  synrax/schema/:
    purpose: "OWL ontology (schema.owl) and SHACL shapes (shapes.ttl) for ArchGraph"
  synrax/query/:
    purpose: "SPARQL query templates and Oxigraph endpoint wrapper"
    depends_on: [synrax/schema/]
  synrax/cli/:
    purpose: "codedna-export CLI entry point (click)"
    depends_on: [synrax/extract/, synrax/query/]
