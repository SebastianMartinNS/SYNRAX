PREFIX arch: <http://archgraph.example.org/>

# Out of Scope: Find modules with NO transitive connection to {{module}} (EXP-2)
# These modules are outside the impact zone and can be safely skipped.
# Note: runs on OWL-RL reasoned graph where transitive closure is materialized,
# so plain dependsOn already includes transitive paths. Identity handled by FILTER.
SELECT DISTINCT ?name WHERE {
  ?m a arch:Module ;
     arch:moduleName ?name .
  FILTER(?m != arch:{{module}})
  FILTER NOT EXISTS {
    arch:{{module}} arch:dependsOn ?m .
  }
  FILTER NOT EXISTS {
    ?m arch:dependsOn arch:{{module}} .
  }
}
ORDER BY ?name
LIMIT 20
